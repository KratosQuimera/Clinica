# ============================================================================
# ClinEstudo - Configuração de Ambiente (.env)
# Copie este arquivo para .env e ajuste para o seu ambiente local de produção
# ============================================================================

# Conexão com o Banco de Dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=clinestudo
DB_USER=postgres
DB_PASSWORD=sua_senha_segura_aqui
DB_SSLMODE=prefer

# Tolerância a falhas: se PostgreSQL estiver offline, permite contingência SQLite local
ALLOW_SQLITE_FALLBACK=true
SQLITE_PATH=clinestudo_local.db

# Políticas de Segurança & Autenticação
MAX_LOGIN_ATTEMPTS=3
LOCKOUT_DURATION_MINUTES=15
SESSION_TIMEOUT_MINUTES=60
SECRET_KEY=gere_uma_chave_aleatoria_longa_para_producao_aqui
